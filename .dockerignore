# Only the released code goes into the image (the allowlist of .gitignore): no data, runs, models or local files.
*
!*.py
!config_cytonucs.json
!requirements.txt
!README.md
!LICENSE
!configs/*.json
!configs/README.md
!paper/*.py
!paper/README.md
!dataset_prep/*.py
!dataset_prep/hela_spheroid_blocks.json
!dataset_prep/synthetic/*.py
!dataset_prep/synthetic/README.md
!baselines/*.py
!baselines/stardist3d/*.py
!baselines/hydrastardist/*.py
!baselines/hydrastardist/LICENSE
!baselines/hydrastardist/hydrastardist/
!baselines/cellpose/run_cellpose.py
!baselines/cellpose/run_cellpose3d.py
!baselines/cellpose/run_cellpose3d_files.py
!baselines/instanseg/*.py
!baselines/nnunet/*.py
!docker/
overfit.py
paper_queue.py
run_inference.py
**/__pycache__
**/*.pyc
