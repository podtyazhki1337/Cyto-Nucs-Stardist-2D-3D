# Only the code of the method, its baselines and the dataset converters is tracked. Models, data, run results,
# tests, audits, notes and old configuration versions stay local.
/*
!/.gitignore
!/Readme.md
!/*.py
!/config_cytonucs.json
/overfit.py
/paper_queue.py
/run_inference.py

!/dataset_prep/
/dataset_prep/*
!/dataset_prep/*.py
!/dataset_prep/synthetic/
/dataset_prep/synthetic/*
!/dataset_prep/synthetic/*.py
!/dataset_prep/synthetic/README.md

# Baselines of the paper: their code (StarDist runs, the vendored HydraStarDist package with its BSD licence),
# not their models or logs.
!/baselines/
/baselines/*
!/baselines/*.py
!/baselines/stardist3d/
/baselines/stardist3d/*
!/baselines/stardist3d/*.py
!/baselines/hydrastardist/
/baselines/hydrastardist/*
!/baselines/hydrastardist/*.py
!/baselines/hydrastardist/LICENSE
!/baselines/hydrastardist/hydrastardist/
!/baselines/cellpose/
/baselines/cellpose/*
!/baselines/cellpose/*.py
!/baselines/nnunet/
/baselines/nnunet/*
!/baselines/nnunet/*.py

__pycache__/
*.pyc
