# Only the code of the method, its baselines, the dataset converters, the configurations of the paper's models and
# the paper's analysis scripts are tracked. Models, data, run results, notes and local scripts stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CITATION.cff
!/.zenodo.json
!/requirements.txt
!/*.py
!/config_cytonucs.json
!/Dockerfile
!/.dockerignore
!/docker/
!/docs/
/docs/*
!/docs/figures/
/overfit.py
/paper_queue.py
/run_inference.py

!/configs/
/configs/*
!/configs/*.json
!/configs/README.md

!/paper/
/paper/*
!/paper/*.py
!/paper/README.md

!/dataset_prep/
/dataset_prep/*
!/dataset_prep/*.py
!/dataset_prep/hela_spheroid_blocks.json
!/dataset_prep/splits/
/dataset_prep/splits/*
!/dataset_prep/splits/*.json
!/dataset_prep/splits/README.md
!/dataset_prep/synthetic/
/dataset_prep/synthetic/*
!/dataset_prep/synthetic/*.py
!/dataset_prep/synthetic/README.md

# Baselines: their code (the vendored HydraStarDist package keeps its BSD licence), not their models or logs.
!/baselines/
/baselines/*
!/baselines/*.py
!/baselines/stardist3d/
/baselines/stardist3d/*
!/baselines/stardist3d/*.py
!/baselines/hydrastardist/
/baselines/hydrastardist/*
!/baselines/hydrastardist/*.py
!/baselines/hydrastardist/LICENSE
!/baselines/hydrastardist/hydrastardist/
!/baselines/cellpose/
/baselines/cellpose/*
!/baselines/cellpose/run_cellpose.py
!/baselines/cellpose/run_cellpose3d.py
!/baselines/cellpose/run_cellpose3d_files.py
!/baselines/instanseg/
/baselines/instanseg/*
!/baselines/instanseg/*.py
!/baselines/nnunet/
/baselines/nnunet/*
!/baselines/nnunet/*.py

__pycache__/
*.pyc
