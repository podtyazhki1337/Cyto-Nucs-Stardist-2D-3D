{
  "mode": "inference",

  "experiment": {
    "name": "cytonucs_emese_3_stardist_3d_2dculture",
    "use_comet": false,
    "comet_api_key": "",
    "comet_project": "cytonucs",
    "comet_workspace": "podtyazhki1337"
  },

  "data": {
    "dataset_dir": "/NAS/mmaiurov/Datasets/Cytonucs_Emese/preprocessed/",
    "validation_images": [],
    "skip_images": [],
    "pool_size": null,
    "repool_freq": 10
  },

  "preprocessing": {
    "run_preprocessing": false,
    "raw_images_dir": "/NAS/mmaiurov/Datasets/Cytonucs_Emese/images/",
    "raw_nucleus_masks_dir": "/NAS/mmaiurov/Datasets/Cytonucs_Emese/nuc_masks/",
    "raw_cytoplasm_masks_dir": "/NAS/mmaiurov/Datasets/Cytonucs_Emese/cyto_masks/",
    "output_dir": "/NAS/mmaiurov/Datasets/Cytonucs_Emese/preprocessed/",
    "test_split": 0.1,
    "val_split": 0.1,
    "compute_assignments": true,
    "seed": 42
  },

  "model": {
    "ndim": 3,
    "n_rays": 96,
    "anisotropy": [5, 1, 1],
    "nucleus_grid": [1, 2, 2],
    "cytoplasm_grid": [1, 2, 2],
    "shared_encoder": true,
    "n_channel_in": 3,
    "use_gpu": true,
    "unet_n_depth": 4,
    "unet_n_filter_base": 32,
    "net_conv_after_unet": 128,
    "mask_refinement_filters": 64

  },

  "training": {
    "train_patch_size": [16, 448, 448],
    "train_batch_size": 1,
    "train_epochs": 300,
    "steps_per_epoch": 100,
    "initial_learning_rate": 3e-4,
    "lr_decay_steps": 1700,
    "lr_decay_rate": 0.85,
    "lr_warmup_epochs": 3,
    "lr_staircase": true,
    "gradient_clip_norm": 0.0,
    "fg_crop_prob": 0.9,
    "resume_from_checkpoint": "/storage02/miroslavm/Multi-Nuclear-Stardist-2D-3D/models/cytonucs_emese_3_stardist_3d_2dculture/weights_epoch_200.weights.h5"
  },
  "inference": {
    "checkpoint_path": "/storage02/miroslavm/Multi-Nuclear-Stardist-2D-3D/models/cytonucs_emese_3_stardist_3d_2dculture/weights_best.weights.h5",
    "nms_thresh": 0.3,
    "prob_thresh_nucleus": 0.5,
    "prob_thresh_cytoplasm": 0.5,
    "mask_thresh": 0.25,
    "bbox_padding_factor": 1.5,
    "save_pred_tiff": true
  },

   "loss_weights": {
    "lambda_prob_nucleus": 1.0,
    "lambda_dist_nucleus": 0.2,
    "lambda_prob_cytoplasm": 1.0,
    "lambda_dist_cytoplasm": 0.2,
    "lambda_containment": 0.1,
    "lambda_wbr": 0.15,
    "lambda_consistency": 0,
    "enable_consistency": false,
    "lambda_fragmentation": 0.0,
    "lambda_background_penalty": 0,
    "lambda_cyto_mask": 0.4,
    "lambda_nuc_mask": 0.4


   },
  "loss_params": {
    "containment_margin": 2.0,
    "max_assignment_distance": 50.0,
    "wbr_sigma": 2.0,
    "wbr_warmup_epochs": 30,
    "w_containment_geometric": 1.0,
    "w_containment_distance": 0.5,
    "w_center_separation": 0.2,
    "w_cyto_support": 0.15,
    "dist_loss": "mae",
    "huber_delta": 1.0
  },

  "augmentation": {
    "enable": true,
    "flip_prob": 0.5,
    "rotation_yx": true,
    "intensity_range": [0.6, 2.0],
    "intensity_offset": [-0.2, 0.2],
    "gamma_range": [0.9, 1.1],
    "noise_sigma": 0.01,
    "zoom_range": [0.75, 1.35],
    "blur_sigma_range": null
  },

  "evaluation": {
    "eval_dice_every": 1,
    "min_eval_epoch": 0,
    "prob_thresh_range": [0.3, 0.4, 0.5, 0.6, 0.7, 0.8],
    "nms_thresh_range": [0.15, 0.2, 0.25, 0.3, 0.4],
    "mask_thresh_range": [0.25, 0.35, 0.45, 0.55],
    "threshold_opt_splits": ["val"],
    "compute_jtpr": true,
    "save_predictions": true,
    "save_every_n_epochs": 10

  },
  "gpu_config": {
    "allow_growth": true,
    "memory_limit": null,
    "visible_devices": "1"
    },

  "output": {
    "basedir": "models",
    "save_best_dice": true,
    "save_history": false
  }
}
