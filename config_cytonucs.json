{
  "mode": "train",

  "experiment": {
    "name": "cytonucs_hollandi_stardist_2d",
    "use_comet": false,
    "comet_api_key": "",
    "comet_project": "cytonucs",
    "comet_workspace": "podtyazhki1337"
  },

  "data": {
    "dataset_dir": "/NAS/mmaiurov/Datasets/Cytonucs_Hollandi/preprocessed/",
    "validation_images": [],
    "skip_images": [],
    "pool_size": null,
    "repool_freq": 10
  },

  "preprocessing": {
    "run_preprocessing": false,
    "raw_images_dir": "/NAS/mmaiurov/Datasets/Cytonucs_Hollandi/images/",
    "raw_nucleus_masks_dir": "/NAS/mmaiurov/Datasets/Cytonucs_Hollandi/nuc_masks/",
    "raw_cytoplasm_masks_dir": "/NAS/mmaiurov/Datasets/Cytonucs_Hollandi/cyto_masks/",
    "output_dir": "/NAS/mmaiurov/Datasets/Cytonucs_Hollandi/preprocessed/",
    "test_split": 0.1,
    "val_split": 0.1,
    "compute_assignments": true,
    "seed": 42
  },

  "model": {
    "ndim": 2,
    "n_rays": 128,
    "anisotropy": [1, 1],
    "nucleus_grid": [1, 1],
    "cytoplasm_grid": [1, 1],
    "shared_encoder": true,
    "n_channel_in": 3,
    "use_gpu": true
  },

  "training": {
    "train_patch_size": [512, 512],
    "train_batch_size": 4,
    "train_epochs": 400,
    "steps_per_epoch": 32,
    "initial_learning_rate": 3e-4,
    "lr_decay_steps": 5000,
    "lr_decay_rate": 0.9,
    "lr_staircase": true,
    "gradient_clip_norm": 10,
    "resume_from_checkpoint": null
  },
  "inference": {
    "checkpoint_path": "/storage02/miroslavm/Multi-Nuclear-Stardist-2D-3D/models/cytonucs_hollandi_stardist_2d/weights_best.weights.h5",
    "nms_thresh": 0.3,
    "prob_thresh_nucleus": 0.3,
    "prob_thresh_cytoplasm": 0.4
  },

  "loss_weights": {
    "lambda_prob_nucleus": 1,
    "lambda_dist_nucleus": 1,
    "lambda_prob_cytoplasm": 1,
    "lambda_dist_cytoplasm": 3.5,
    "lambda_containment": 0.1,
    "lambda_wbr": 0.15,
    "lambda_consistency": 0,
    "enable_consistency": false,
    "lambda_fragmentation": 0.05,
    "lambda_background_penalty": 0.05
  },
  "loss_params": {
    "containment_margin": 2.0,
    "max_assignment_distance": 200.0,
    "wbr_sigma": 2.0,
    "wbr_warmup_epochs": 0,
    "w_containment_geometric": 1.0,
    "w_containment_distance": 0.5,
    "w_center_separation": 0.2,
    "w_cyto_support": 0.15,
    "dist_nucleus_norm": 50.0,
    "dist_cytoplasm_norm": 55.0,
    "median_max_dist_cytoplasm": 50.0,
    "median_max_dist_nucleus": 99.0,
    "dist_loss": "mae",
    "huber_delta": 0.1
  },

  "augmentation": {
    "enable": true,
    "flip_prob": 0.5,
    "rotation_yx": true,
    "intensity_range": [0.6, 2.0],
    "intensity_offset": [-0.2, 0.2],
    "gamma_range": [0.9, 1.1],
    "noise_sigma": 0.01,
    "zoom_range": null,
    "blur_sigma_range": null
  },

  "evaluation": {
    "eval_dice_every": 1,
    "optimize_thresholds": true,
    "prob_thresh_range": [0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5],
    "nms_thresh_range": [0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5],
    "compute_jtpr": true,
    "save_predictions": true
  },
  "gpu_config": {
    "allow_growth": true,
    "memory_limit": null,
    "visible_devices": "1"
  },
  "output": {
    "basedir": "models",
    "save_best_dice": true,
    "save_every_n_epochs": 10,
    "save_history": false
  }
}
